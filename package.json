{
  "name": "mfe-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "modules/frontend/packages/*"
  ],
  "scripts": {
    "pretest": "npm run build --workspace=@mfe/shared",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local.ps1",
    "validate:local": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-local.ps1",
    "e2e:serve": "node ./scripts/e2e-serve.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p .",
    "check:contrast": "node ./scripts/check-contrast.mjs",
    "check:docs": "node ./scripts/check-docs.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.1"
  }
}
